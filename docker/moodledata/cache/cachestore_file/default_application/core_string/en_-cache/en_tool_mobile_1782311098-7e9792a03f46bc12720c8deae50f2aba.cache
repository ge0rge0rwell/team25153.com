a:170:{s:18:"activitiesoverview";s:19:"Activities overview";s:17:"adodbdebugwarning";s:137:"ADOdb debugging is enabled. It should be disabled in the external database authentication or external database enrolment plugin settings.";s:12:"androidappid";s:31:"Android app's unique identifier";s:17:"androidappid_desc";s:73:"This setting may be left as default unless you have a custom Android app.";s:9:"apppolicy";s:14:"App policy URL";s:14:"apppolicy_help";s:149:"The URL of a policy for app users which is listed on the About page in the app. If the field is left empty, the site policy URL will be used instead.";s:11:"apprequired";s:88:"This functionality is only available when accessed via the Moodle mobile or desktop app.";s:29:"autologinkeygenerationlockout";s:85:"Auto-login key generation is blocked. You need to wait {$a} minutes between requests.";s:26:"autologinmintimebetweenreq";s:40:"Minimum time between auto-login requests";s:31:"autologinmintimebetweenreq_desc";s:195:"The minimum time between auto-login requests from the mobile app. If app users are frequently asked to enter their credentials when viewing content embedded from the site, then set a lower value.";s:27:"autologinnotallowedtoadmins";s:42:"Auto-login is not allowed for site admins.";s:10:"autologout";s:34:"Enforce auto logout for your users";s:15:"autologout_desc";s:190:"For security reasons, you can enforce automatic logout for your users when they leave or close the app, or it goes to background. Users will have to log in again when they return to the app.";s:16:"autologoutcustom";s:46:"Custom time after users leave or close the app";s:19:"autologoutinmediate";s:46:"Immediately after users leave or close the app";s:14:"autologouttime";s:17:"Auto logout timer";s:14:"billedannually";s:15:"Billed annually";s:8:"branding";s:8:"Branding";s:19:"cachedef_plugininfo";s:50:"This stores the list of plugins with mobile addons";s:25:"cachedef_subscriptioninfo";s:52:"This stores the Moodle app subscription information.";s:23:"clickheretolaunchtheapp";s:50:"Click here if the app does not open automatically.";s:18:"configmobilecssurl";s:50:"A CSS file to customise your mobile app interface.";s:12:"currentusage";s:13:"Current usage";s:13:"customisation";s:13:"Customisation";s:17:"customlangstrings";s:23:"Custom language strings";s:22:"customlangstrings_desc";s:365:"Words and phrases displayed in the app can be customised here. Enter each custom language string on a new line with format: string identifier, custom language string and language code, separated by pipe characters. For example:
<pre>
core.user.student|Learner|en
core.user.student|Aprendiz|es
</pre>
For a complete list of string identifiers, see the documentation.";s:15:"custommenuitems";s:17:"Custom menu items";s:20:"custommenuitems_desc";s:1053:"Additional items can be added to the app's main menu by specifying them here. Enter each custom menu item on a new line with format: item text, link URL, link-opening method and language code (optional, for displaying the item to users of the specified language only), separated by pipe characters.

Link-opening methods are: app (for linking to an activity supported by the app), inappbrowser (for opening a link in a browser without leaving the app), browser (for opening the link in the device default browser outside the app) and embedded (for displaying the link in an iframe in a new page in the app).

When items are missing a translation for a given language, they will use other languages as fallback unless "_only" is appended to the language code.

For example:
<pre>
App help|https://someurl.xyz/help|inappbrowser
My grades|https://someurl.xyz/local/mygrades/index.php|embedded|en
Mis calificaciones|https://someurl.xyz/local/mygrades/index.php|embedded|es
You will only see this in English|https://someurl.xyz/english|browser|en_only
</pre>";s:19:"customusermenuitems";s:22:"Custom user menu items";s:24:"customusermenuitems_desc";s:1058:"Additional items can be added to the app's user menu by specifying them here. Enter each custom user menu item on a new line with format: item text, link URL, link-opening method and language code (optional, for displaying the item to users of the specified language only), separated by pipe characters.

Link-opening methods are: app (for linking to an activity supported by the app), inappbrowser (for opening a link in a browser without leaving the app), browser (for opening the link in the device default browser outside the app) and embedded (for displaying the link in an iframe in a new page in the app).

When items are missing a translation for a given language, they will use other languages as fallback unless "_only" is appended to the language code.

For example:
<pre>
App help|https://someurl.xyz/help|inappbrowser
My grades|https://someurl.xyz/local/mygrades/index.php|embedded|en
Mis calificaciones|https://someurl.xyz/local/mygrades/index.php|embedded|es
You will only see this in English|https://someurl.xyz/english|browser|en_only
</pre>";s:8:"darkmode";s:9:"Dark mode";s:18:"devicelimitnotrack";s:36:"Per device limit (no usage tracking)";s:16:"disabledfeatures";s:17:"Disabled features";s:21:"disabledfeatures_desc";s:244:"Select here the features you want to disable in the Mobile app for your site. Please note that some features listed here could be already disabled via other site settings. You will have to log out and log in again in the app to see the changes.";s:20:"displayerrorswarning";s:72:"Display debug messages (debugdisplay) is enabled. It should be disabled.";s:14:"downloadcourse";s:15:"Download course";s:15:"downloadcourses";s:16:"Download courses";s:21:"enablesmartappbanners";s:18:"Enable App Banners";s:26:"enablesmartappbanners_desc";s:111:"If enabled, a banner promoting the mobile app will be displayed when accessing the site using a mobile browser.";s:8:"enhanced";s:7:"Premium";s:7:"feature";s:7:"Feature";s:17:"featurecomparison";s:18:"Feature comparison";s:21:"filetypeexclusionlist";s:24:"File type exclusion list";s:26:"filetypeexclusionlist_desc";s:315:"Select all file types which are not for use on a mobile device. Such files will be listed in the course, then if a user attempts to open them, a warning will be displayed advising that the file type is not intended for use on a mobile device. The user can then cancel or ignore the warning and open the file anyway.";s:32:"filetypeexclusionlistplaceholder";s:31:"Mobile file type exclusion list";s:15:"forcedurlscheme";s:242:"If you want to allow only your custom branded app to be opened via a browser window, then specify its URL scheme here. If you want to allow only the official app, then set the default value. Leave the field empty if you want to allow any app.";s:19:"forcedurlscheme_key";s:10:"URL scheme";s:11:"forcelogout";s:13:"Force log out";s:16:"forcelogout_desc";s:167:"If enabled, users will be always completely logged out even when switching accounts. They must then re-enter their password the next time they wish to access the site.";s:18:"fullaccessfeatures";s:37:"You have full access to {$a} features";s:21:"getmoodleonyourmobile";s:18:"Get the mobile app";s:10:"h5poffline";s:24:"View H5P content offline";s:13:"httpsrequired";s:14:"HTTPS required";s:24:"insecurealgorithmwarning";s:120:"It seems that the HTTPS certificate uses an insecure algorithm for signing (SHA-1). Please try updating the certificate.";s:30:"invalidcertificatechainwarning";s:115:"It seems that the certificate chain is invalid. This certificate might work for a browser but not for a mobile app.";s:35:"invalidcertificateexpiredatewarning";s:61:"It seems that the HTTPS certificate for the site has expired.";s:34:"invalidcertificatestartdatewarning";s:100:"It seems that the HTTPS certificate for the site is not yet valid (with a start date in the future).";s:19:"invalidprivatetoken";s:77:"Invalid private token. Token should not be empty or passed via GET parameter.";s:23:"invaliduserquotawarning";s:136:"The user quota (userquota) is set to an invalid number. It should be set to a valid number (an integer value) in Site security settings.";s:8:"iosappid";s:27:"iOS app's unique identifier";s:13:"iosappid_desc";s:69:"This setting may be left as default unless you have a custom iOS app.";s:22:"launchviasiteinbrowser";s:33:"Launch via site in system browser";s:9:"learnmore";s:10:"Learn more";s:22:"limiteddisabledfeature";s:114:"Your <strong>{$a->plan}</strong> plan allows {$a->limit} {$a->feature}. <a href="{$a->url}">View plan details</a>.";s:30:"limiteddisabledfeature_related";s:186:"Your <strong>{$a->plan}</strong> plan allows {$a->limit} item total across <strong>{$a->feature1}</strong> and <strong>{$a->feature2}</strong>. <a href="{$a->url}">View plan details</a>.";s:15:"limitedfeatures";s:16:"Limited features";s:13:"loginintheapp";s:11:"Via the app";s:17:"logininthebrowser";s:38:"Via a browser window (for SSO plugins)";s:25:"loginintheembeddedbrowser";s:41:"Via an embedded browser (for SSO plugins)";s:18:"logoutconfirmation";s:217:"Are you sure you want to log out from the mobile app on your mobile devices? By logging out, you will then need to re-enter your username and password in the mobile app on all devices where you have the app installed.";s:26:"lookingforcsscustomisation";s:30:"Looking for CSS customisation?";s:31:"lookingforcustomisationfeatures";s:35:"Looking for customisation features?";s:21:"lookingforqrcodelogin";s:26:"Looking for QR code login?";s:8:"mainmenu";s:9:"Main menu";s:6:"manage";s:6:"Manage";s:15:"managefiletypes";s:17:"Manage file types";s:14:"minimumversion";s:165:"If an app version is specified (3.8.0 or higher), any users using an older app version will be prompted to upgrade their app before being allowed access to the site.";s:18:"minimumversion_key";s:28:"Minimum app version required";s:9:"mobileapp";s:10:"Mobile app";s:16:"mobileappearance";s:17:"Mobile appearance";s:16:"mobileappenabled";s:89:"This site has mobile app access enabled.<br /><a href="{$a}">Download the mobile app</a>.";s:21:"mobileappsubscription";s:23:"Moodle app subscription";s:20:"mobileauthentication";s:21:"Mobile authentication";s:12:"mobilecssurl";s:3:"CSS";s:14:"mobilefeatures";s:15:"Mobile features";s:34:"mobilenotificationsdisabledwarning";s:86:"Mobile notifications are not enabled. They should be enabled in Notification settings.";s:14:"mobilesettings";s:15:"Mobile settings";s:31:"moodleappsportalfeatureswarning";s:169:"Please note that some features may be restricted depending on your Moodle app subscription. For details, visit the <a href="{$a}" target="_blank">Moodle Apps Portal</a>.";s:25:"movedcsstopremiumfeatures";s:101:"CSS for mobile app customisation has been moved to the <a href="{$a->url}">{$a->urlname}</a> section.";s:30:"moveddisabledtopremiumfeatures";s:148:"Features like disabled features, custom menu items, and language customisation have been moved to the <a href="{$a->url}">{$a->urlname}</a> section.";s:24:"movedqrtopremiumfeatures";s:172:"QR code access has been moved to the <a href="{$a->url}">{$a->urlname}</a> section. This includes both basic QR code (free) and automatic QR code login ({$a->upgradename}).";s:3:"new";s:13:"(New! ⭐️)";s:13:"nosubsblocked";s:82:"Your Moodle server may be blocking outbound connections to the Moodle Apps Portal.";s:21:"nosubscouldntretrieve";s:38:"We couldn't retrieve your plan details";s:12:"nosubsoerror";s:159:"Unable to connect to Moodle Apps Portal. Your plan, feature limits, and usage data are temporarily unavailable. This doesn’t affect your active subscription.";s:14:"nosubstryagain";s:9:"Try again";s:14:"nosubsviewplan";s:40:"View your plan on the Moodle Apps Portal";s:15:"nosubswhyhappen";s:22:"Why might this happen?";s:13:"notifications";s:13:"Notifications";s:26:"notificationsactivedevices";s:14:"Active devices";s:33:"notificationscurrentactivedevices";s:42:"Devices receiving notifications this month";s:33:"notificationsignorednotifications";s:22:"Notifications not sent";s:25:"notificationslimitreached";s:146:"Monthly device limit reached. Some users are not receiving push notifications. Upgrade your plan to ensure all users receive mobile notifications.";s:27:"notificationsmissingwarning";s:158:"Unable to retrieve Moodle app notification statistics. Ensure mobile notifications are enabled in <a href="{$a}">Site administration > Messaging > Mobile</a>.";s:23:"notificationsnewdevices";s:11:"New devices";s:20:"notificationsseemore";s:215:"Note: Moodle app usage statistics are not calculated in real time. To access more detailed statistics, including data from previous months, please log in to the <a href="{$a}" target="_blank">Moodle Apps Portal</a>.";s:30:"notificationssentnotifications";s:18:"Notifications sent";s:23:"oauth2identityproviders";s:26:"OAuth 2 identity providers";s:10:"offlineuse";s:11:"Offline use";s:12:"planbenefits";s:23:"Your {$a} plan benefits";s:13:"plancontinues";s:40:"Your {$a} plan continues without changes";s:11:"plandetails";s:28:"Your Moodle app subscription";s:13:"planexpireson";s:16:"Expires on {$a}.";s:12:"planfeatures";s:13:"{$a} features";s:15:"planlastchecked";s:33:"Plan status last checked on {$a}.";s:16:"planneverchecked";s:35:"Plan status has never been checked.";s:10:"pluginname";s:16:"Moodle app tools";s:28:"pluginnotenabledorconfigured";s:33:"Plugin not enabled or configured.";s:18:"premiumfeatureonly";s:20:"Premium feature only";s:15:"premiumfeatures";s:16:"Premium features";s:29:"privacy:metadata:core_userkey";s:63:"User's keys used to create auto-login key for the current user.";s:62:"privacy:metadata:preference:tool_mobile_autologin_request_last";s:89:"The date of the last auto-login key request. Between each request 6 minutes are required.";s:14:"qrcodedisabled";s:27:"Access via QR code disabled";s:24:"qrcodeformobileappaccess";s:29:"QR code for mobile app access";s:28:"qrcodeformobileapploginabout";s:111:"Scan the QR code with your mobile app and you will be automatically logged in. The QR code will expire in {$a}.";s:26:"qrcodeformobileappurlabout";s:74:"Scan the QR code with your mobile app to fill in the site URL in your app.";s:10:"qrcodetype";s:14:"QR code access";s:15:"qrcodetype_desc";s:182:"Mobile users can scan a QR code to fill in the site URL. For secure (HTTPS) sites, the code also enables automatic login without the user having to enter their username and password.";s:15:"qrcodetypelogin";s:28:"QR code with automatic login";s:13:"qrcodetypeurl";s:28:"QR code with site URL (free)";s:8:"qrkeyttl";s:30:"QR authentication key duration";s:13:"qrkeyttl_desc";s:68:"The length of time for which a QR code for automatic login is valid.";s:13:"qronlypremium";s:131:"{$a->feature} is only available in Premium. Upgrade to use QR code with automatic login. <a href="{$a->url}">View plan details</a>.";s:13:"qrsameipcheck";s:31:"QR authentication same IP check";s:18:"qrsameipcheck_desc";s:151:"Whether users must use the same network for both generating and scanning a QR code for login. Only disable it if users report issues with the QR login.";s:22:"qrsiteadminsnotallowed";s:118:"For security reasons login via QR code is not allowed for site administrators or if you are logged in as another user.";s:25:"readingthisemailgettheapp";s:125:"Are you reading this in an email? <a href="{$a}">Download the mobile app and receive notifications on your mobile device</a>.";s:17:"refreshplanstatus";s:19:"Refresh plan status";s:8:"register";s:8:"Register";s:23:"responsivemainmenuitems";s:21:"Responsive menu items";s:10:"scanqrcode";s:12:"Scan QR code";s:15:"scriptallowlist";s:30:"Allowlisted JavaScript domains";s:20:"scriptallowlist_desc";s:397:"Enter the domains from which external JavaScript files are allowed to be loaded by the Moodle app when detected in user-generated HTML content.<br>
Each domain must be written on a separate line. Scripts whose source belongs to one of the listed domains will be allowed to load. Scripts from other domains will continue to be blocked.<br>
Inline JavaScript is always blocked and cannot be allowed.";s:39:"selfsignedoruntrustedcertificatewarning";s:249:"It seems that the HTTPS certificate is self-signed or not trusted. The mobile app will only work with trusted sites. Please use any online SSL checker to diagnose the problem. If it indicates that your certificate is OK, you can ignore this warning.";s:9:"setuplink";s:17:"App download page";s:14:"setuplink_desc";s:206:"URL of page with options to download the mobile app from the App Store and Google Play. The app download page link is displayed in the page footer and in a user's profile. Leave blank to not display a link.";s:17:"showingcacheddata";s:47:"Last synced: {$a->since} days ago ({$a->date}).";s:15:"showinglivedata";s:76:"View live data in the <a href="{$a}" target="_blank">Moodle Apps Portal</a>.";s:11:"siteplugins";s:12:"Site plugins";s:15:"smartappbanners";s:11:"App Banners";s:12:"subscription";s:12:"Subscription";s:19:"subscriptioncreated";s:10:"Start date";s:24:"subscriptionerrorrequest";s:95:"There was an unexpected error when trying to retrieve your Moodle app subscription information.";s:22:"subscriptionexpiration";s:11:"Expiry date";s:29:"subscriptionfeaturenotapplied";s:126:"This feature is configured on your site but it is not included in your Moodle app plan. Thus, the setting will have no effect.";s:20:"subscriptionfeatures";s:21:"Subscription features";s:26:"subscriptionlimitsurpassed";s:27:"Subscription limit exceeded";s:20:"subscriptionregister";s:152:"For details of the various app plans, and to access Moodle app usage statistics, please visit the <a href="{$a}" target="_blank">Moodle Apps Portal</a>.";s:20:"subscriptionsseemore";s:237:"Note: The information displayed is not updated in real time. You may need to log out and log in again to see updates. For information on upgrading your app plan, please log in to the <a href="{$a}" target="_blank">Moodle Apps Portal</a>.";s:13:"switchaccount";s:14:"Switch account";s:28:"taskrefreshsubscriptioncache";s:49:"Refresh Moodle app subscription information cache";s:11:"typeoflogin";s:13:"Type of login";s:16:"typeoflogin_desc";s:223:"If the site uses a Single Sign-On (SSO) authentication method, then select via a browser window or via an embedded browser. An embedded browser provides a better user experience, though it doesn't work with all SSO plugins.";s:17:"upgradeforunlimit";s:37:"Upgrade to {$a} for unlimited access.";s:17:"upgradeplanlimits";s:57:"Some features are available with limits on the {$a} plan.";s:19:"upgraderemovelimits";s:37:"Upgrade to {$a} and remove all limits";s:21:"upgradetosubscription";s:15:"Upgrade to {$a}";s:15:"upgradeyourplan";s:25:"(Upgrade your plan! 🚀)";s:10:"viewqrcode";s:12:"View QR code";s:12:"remoteaddons";s:14:"Remote add-ons";}