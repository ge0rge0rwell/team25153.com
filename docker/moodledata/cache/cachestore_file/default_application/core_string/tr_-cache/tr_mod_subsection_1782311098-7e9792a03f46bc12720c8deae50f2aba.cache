a:23:{s:23:"cleandescriptionsdetail";s:570:"Subsection pages and descriptions are no longer supported in Moodle 5.2.
<p>This site has <strong>{$a->count} subsection descriptions</strong> that are no longer visible to users.</p>
<p>You can choose to:
<ul>
  <li><strong>Migrate these descriptions to Text and Media areas</strong>.<br/> The Text and media areas will be displayed at the top of each subsection.<br/>{$a->migratelink}<br/><br/>
  </li>
  <li><strong>Delete these descriptions permanently</strong>.<br/> This will completely erase descriptions from the database.<br/>{$a->deletelink}
  </li>
</ul>
</p>";s:19:"deleteconfirmbutton";s:23:"Delete all descriptions";s:17:"deleteconfirmtext";s:156:"This will permanently delete {$a} subsection descriptions from the database.<br/><br/>You can't undo this. Are you sure you want to delete all descriptions?";s:18:"deleteconfirmtitle";s:35:"Delete all subsection descriptions?";s:14:"deletelinktext";s:19:"Delete descriptions";s:26:"descriptionsdeletedpending";s:68:"Subsection descriptions waiting to be deleted: <strong>{$a}</strong>";s:26:"descriptionsdeletedsuccess";s:148:"<strong>The removal task for all subsection descriptions has been created</strong>. This task will run in the background and may take a few minutes.";s:27:"descriptionsmigratedpending";s:69:"Subsection descriptions waiting to be migrated: <strong>{$a}</strong>";s:27:"descriptionsmigratedsuccess";s:150:"<strong>The migration task for all subsection descriptions has been created</strong>. This task will run in the background and may take a few minutes.";s:13:"invalidaction";s:25:"Invalid action specified.";s:20:"migrateconfirmbutton";s:24:"Migrate all descriptions";s:18:"migrateconfirmtext";s:152:"This will migrate {$a} subsection descriptions to Text and Media areas.<br/><br/>You can't undo this. Are you sure you want to migrate all descriptions?";s:19:"migrateconfirmtitle";s:36:"Migrate all subsection descriptions?";s:15:"migratelinktext";s:20:"Migrate descriptions";s:10:"modulename";s:10:"Subsection";s:16:"modulenameplural";s:11:"Subsections";s:20:"pluginadministration";s:25:"Subsection administration";s:10:"pluginname";s:10:"Subsection";s:16:"privacy:metadata";s:43:"Subsection does not store any personal data";s:15:"quickcreatename";s:14:"New subsection";s:22:"subsection:addinstance";s:14:"Add subsection";s:15:"subsection:view";s:15:"View subsection";s:14:"subsectionname";s:4:"Name";}