a:46:{s:28:"action:explain_text:endpoint";s:12:"API endpoint";s:25:"action:explain_text:model";s:8:"AI model";s:30:"action:explain_text:model_help";s:44:"The model used to explain the provided text.";s:37:"action:explain_text:systeminstruction";s:18:"System instruction";s:42:"action:explain_text:systeminstruction_help";s:142:"This instruction is sent to the AI model along with the user's prompt. Editing this instruction is not recommended unless absolutely required.";s:30:"action:generate_image:endpoint";s:12:"API endpoint";s:27:"action:generate_image:model";s:8:"AI model";s:32:"action:generate_image:model_help";s:52:"The model used to generate images from user prompts.";s:39:"action:generate_image:systeminstruction";s:18:"System instruction";s:44:"action:generate_image:systeminstruction_help";s:142:"This instruction is sent to the AI model along with the user's prompt. Editing this instruction is not recommended unless absolutely required.";s:29:"action:generate_text:endpoint";s:12:"API endpoint";s:26:"action:generate_text:model";s:8:"AI model";s:31:"action:generate_text:model_help";s:45:"The model used to generate the text response.";s:38:"action:generate_text:systeminstruction";s:18:"System instruction";s:43:"action:generate_text:systeminstruction_help";s:142:"This instruction is sent to the AI model along with the user's prompt. Editing this instruction is not recommended unless absolutely required.";s:30:"action:summarise_text:endpoint";s:12:"API endpoint";s:27:"action:summarise_text:model";s:8:"AI model";s:32:"action:summarise_text:model_help";s:46:"The model used to summarise the provided text.";s:39:"action:summarise_text:systeminstruction";s:18:"System instruction";s:44:"action:summarise_text:systeminstruction_help";s:142:"This instruction is sent to the AI model along with the user's prompt. Editing this instruction is not recommended unless absolutely required.";s:6:"apikey";s:14:"Gemini API key";s:11:"apikey_help";s:106:"Get a key from <a href="https://aistudio.google.com/apikey" target="_blank">Google AI Studio API keys</a>.";s:17:"custom_model_name";s:17:"Custom model name";s:11:"extraparams";s:16:"Extra parameters";s:16:"extraparams_help";s:147:"Extra parameters can be configured here. We support JSON format. For example:
<pre>
{
    "temperature": 0.5,
    "max_output_tokens": 100
}
</pre>";s:18:"getallmodels_error";s:37:"You need to insert the API key first.";s:11:"invalidjson";s:19:"Invalid JSON string";s:10:"pluginname";s:19:"Gemini API provider";s:16:"privacy:metadata";s:64:"The Gemini API provider plugin does not store any personal data.";s:50:"privacy:metadata:aiprovider_gemini:externalpurpose";s:246:"This information is sent to the Gemini API in order for a response to be generated. Your Gemini account settings may change how Gemini stores and retains this data. No user data is explicitly sent to Gemini or stored in Moodle LMS by this plugin.";s:40:"privacy:metadata:aiprovider_gemini:model";s:40:"The model used to generate the response.";s:47:"privacy:metadata:aiprovider_gemini:numberimages";s:65:"When generating images the number of images used in the response.";s:45:"privacy:metadata:aiprovider_gemini:prompttext";s:59:"The user entered text prompt used to generate the response.";s:49:"privacy:metadata:aiprovider_gemini:responseformat";s:50:"When generating images the format of the response.";s:8:"settings";s:8:"Settings";s:13:"settings_help";s:71:"Adjust the settings below to customise how requests are sent to Gemini.";s:26:"settings_max_output_tokens";s:10:"Max tokens";s:31:"settings_max_output_tokens_help";s:56:"The maximum number of tokens used in the generated text.";s:23:"settings_stop_sequences";s:14:"Stop sequences";s:28:"settings_stop_sequences_help";s:102:"Specify one or more character sequences (comma-separated) where the model should stop generating text.";s:20:"settings_temperature";s:11:"Temperature";s:25:"settings_temperature_help";s:249:"Temperature influences whether the output is more random and creative or more predictable. Increasing the temperature will make the model answer more creatively. This setting works alongside other options like top p and top k to generate the output.";s:14:"settings_top_k";s:5:"Top k";s:19:"settings_top_k_help";s:162:"Reduces the probability of generating nonsense. A higher value (e.g. 100) will give more diverse answers, while a lower value (e.g. 10) will be more conservative.";s:14:"settings_top_p";s:5:"Top p";s:19:"settings_top_p_help";s:178:"Top p (nucleus sampling) determines how many possible words to consider. A high value (e.g. 0.9) means the model looks at more words, which makes the generated text more diverse.";}